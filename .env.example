# Copy to .env.local for local development, or add the same keys in
# Vercel -> Project Settings -> Environment Variables.

# Required. Supabase -> Project Settings -> API -> Project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Required. Supabase -> Project Settings -> API -> Project API keys -> anon / public
SUPABASE_ANON_KEY=your-anon-key

# Optional. Supabase -> Project Settings -> API -> Project API keys -> service_role / secret
# Never expose this value to the browser. The app does not currently read it.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Required for the express quote form. Zapier -> your Zap -> Webhook by Zapier -> Catch Hook -> Copy URL.
# Kept server-side; the browser posts to /api/quote/ instead.
ZAPIER_QUOTE_WEBHOOK=your-zapier-catch-webhook-url
